{
  "manifest_version": 3,
  "name": "YouTube & YT Music OBS Overlay Broadcaster",
  "version": "1.3.0",
  "description": "Streams live now-playing video and song info from YouTube & YouTube Music to OBS Studio",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://youtube.com/*",
    "https://music.youtube.com/*",
    "wss://broker.emqx.io/*",
    "wss://broker.hivemq.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OBS Overlay Settings"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
